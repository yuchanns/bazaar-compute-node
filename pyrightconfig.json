{
  "include": [
    "src",
    "tests"
  ],
  "pythonVersion": "3.14",
  "pythonPlatform": "All",
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "reportMatchNotExhaustive": "error",
  "reportUnreachable": "warning",
  "reportUnusedFunction": "warning",
  "reportUnusedVariable": "warning"
}
