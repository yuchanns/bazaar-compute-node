{
  "include": [
    "scripts",
    "tests/run_installed.py"
  ],
  "pythonVersion": "3.15",
  "pythonPlatform": "All",
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "reportMatchNotExhaustive": "error",
  "reportUnreachable": "warning",
  "reportUnusedFunction": "warning",
  "reportUnusedVariable": "warning"
}
