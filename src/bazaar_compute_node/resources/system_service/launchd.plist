<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ label | e }}</string>
    <key>Comment</key>
    <string>{{ managed_marker | e }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ wrapper_path | e }}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{ data_dir | e }}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BCN_CONFIG</key>
        <string>{{ config_path | e }}</string>
        <key>BCN_ENV_FILE</key>
        <string>{{ environment_file | e }}</string>
        <key>BCN_EXECUTABLE</key>
        <string>{{ executable | e }}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>{{ log_path | e }}</string>
    <key>StandardErrorPath</key>
    <string>{{ log_path | e }}</string>
</dict>
</plist>
