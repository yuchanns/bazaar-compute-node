# {{ managed_marker }}
[Unit]
Description=Bazaar Compute Node

[Service]
Type=simple
ExecStart={{ executable }} run --config {{ config_path }}
WorkingDirectory={{ data_dir }}
{% if environment_file %}EnvironmentFile=-{{ environment_file }}
{% endif %}Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
